def number_of_groups(G):
    
    visitados = []
    grupos = 0
    cola = Queue()
    
    
    for node in G:
        if node not in visitados:
            grupos += 1 #el resto a partr de while es el cidogo de un grupo, asi que asi cuento cada grupo
            visitados.append(node)
            cola.enqueue(node)
            
            while not cola.isEmpty():
            
                new_node = cola.dequeue()
            
                for vecino in G.neighbors(new_node):
                    if vecino not in visitados:
                        visitados.append(vecino)
                        cola.enqueue(vecino)
    return grupos
